{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Tag catalog v0.1","type":"object","additionalProperties":false,
 "required":["catalog_version","is_clinically_validated","language","tags"],
 "properties":{
   "catalog_version":{"type":"string"},"is_clinically_validated":{"type":"boolean"},"language":{"const":"ru"},
   "tags":{"type":"array","minItems":1,"uniqueItems":true,"items":{
     "type":"object","additionalProperties":false,
     "required":["code","category","label_ru","description_ru","patient_visible","medical_review_status","enabled_for_llm","enabled_for_clinical_rules","version"],
     "properties":{
       "code":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},
       "category":{"enum":["symptom","topic","event","clarification","safety"]},
       "label_ru":{"type":"string","minLength":2},"description_ru":{"type":"string"},
       "patient_visible":{"type":"boolean"},
       "medical_review_status":{"enum":["pending","approved","rejected"]},
       "enabled_for_llm":{"type":"boolean"},"enabled_for_clinical_rules":{"type":"boolean"},
       "version":{"type":"string"}
     }
   }}
 }
}
