  "clinician_guide": {
    "steps": [
      {
        "id": "before",
        "title": "Подготовка и рамки",
        "clinician_instructions": "Уточните цель обследования, версии инструмента, временной период, язык, информированное согласие и условия конфиденциальности.",
        "checks": []
      },
      {
        "id": "safety",
        "title": "Безопасность",
        "clinician_instructions": "При клинических сигналах риска отдельно оцените непосредственную безопасность и действуйте по протоколу организации, не дожидаясь окончания интервью.",
        "checks": []
      },
      {
        "id": "context",
        "title": "Клинический контекст",
        "clinician_instructions": "Установите хронологию эпизодов, функциональные нарушения, предшествующее лечение, влияние веществ/лекарств, возможные соматические причины и коморбидность.",
        "checks": []
      },
      {
        "id": "start",
        "title": "Правильное проведение",
        "clinician_instructions": "Пациент заполняет официальную версию; обеспечить подходящие условия, понимание языка и отсутствие давления.",
        "checks": []
      },
      {
        "id": "quality",
        "title": "Сначала шкалы валидности",
        "clinician_instructions": "Изучить ICN/INF/NIM/PIM по нормам PAR, количество пропусков и обстоятельства заполнения.",
        "checks": []
      },
      {
        "id": "profile",
        "title": "Профиль",
        "clinician_instructions": "Рассматривать клинические, связанные с лечением и межличностные шкалы как гипотезы, а не самостоятельные диагнозы.",
        "checks": []
      },
      {
        "id": "explain",
        "title": "Обратная связь",
        "clinician_instructions": "Описывать врачу вероятные области дополнительного исследования, пациенту — нейтральные понятные формулировки.",
        "checks": []
      },
      {
        "id": "finish",
        "title": "Завершение",
        "clinician_instructions": "Документируйте подтверждённые, исключённые и неопределённые критерии; решение по диагностическому коду и тактике принимает врач.",
        "checks": []
      }
    ],
    "common_errors": [
      "Считать NIM/PIM доказательством сознательной лжи",
      "Строить T-баллы по выдуманной формуле",
      "Показывать полный профиль до проверки валидности протокола"
    ]
  }
